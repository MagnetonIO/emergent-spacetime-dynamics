cabal-version:      2.2
name:               law4
version:            0.1.0.0
synopsis:           Law IV companion: stabiliser codes, HaPPY-style holographic codes, Fisher metric
description:        Companion code for Paper 4 of the Emergent Spacetime Dynamics modular series.
                    Implements a small stabiliser-code framework, a toy HaPPY-style holographic code,
                    a Fisher information metric calculator for parametric families, and property tests
                    for code distance and complementary recovery.
license:            BSD-3-Clause
author:             MagnetonIO Research
maintainer:         research@magneton.io
build-type:         Simple

common warnings
    ghc-options: -Wall -Wno-unused-imports -Wno-unused-matches -Wno-unused-local-binds -Wno-name-shadowing

library
    import:           warnings
    exposed-modules:  Law4.Pauli
                      Law4.Stabiliser
                      Law4.HaPPY
                      Law4.Fisher
                      Law4.Properties
    build-depends:    base >= 4.14 && < 5
    hs-source-dirs:   src
    default-language: Haskell2010

executable law4-demo
    import:           warnings
    main-is:          Main.hs
    build-depends:    base >= 4.14 && < 5,
                      law4
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite law4-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:    base >= 4.14 && < 5,
                      law4
    hs-source-dirs:   test
    default-language: Haskell2010
