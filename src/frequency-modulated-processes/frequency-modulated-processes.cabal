cabal-version:      2.4
name:               frequency-modulated-processes
version:            0.1.0.0
synopsis:           Law III: Floquet phases as natural transformations
description:        Haskell companion code for "Law III - Frequency-modulated
                    Processes: Floquet Phases as Natural Transformations".
                    Implements a FloquetSystem type, first-order Magnus
                    expansion, kicked Ising chain simulator, and property
                    tests for unitarity and periodicity.
license:            BSD-3-Clause
author:             MagnetonIO Research
maintainer:         research@magneton.io
build-type:         Simple

common warnings
    ghc-options: -Wall -Wcompat

library
    import:           warnings
    exposed-modules:  Floquet.Types
                      Floquet.Magnus
                      Floquet.KickedIsing
                      Floquet.Linalg
    build-depends:    base >= 4.17 && < 5
    hs-source-dirs:   src
    default-language: Haskell2010

executable fmp-demo
    import:           warnings
    main-is:          Main.hs
    build-depends:    base >= 4.17 && < 5,
                      frequency-modulated-processes
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite fmp-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:    base >= 4.17 && < 5,
                      frequency-modulated-processes
    hs-source-dirs:   test
    default-language: Haskell2010
    ghc-options:      -Wno-unused-imports
